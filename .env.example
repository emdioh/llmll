# Copy to .env and fill in. Never commit .env.
# docker compose reads this file automatically. For local runs without Docker, load it into
# the shell first: `set -a; . ./.env; set +a` (JSON values are single-quoted so this works).
#
# ---------------------------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------------------------
# Choose ONE default provider: anthropic (default), openai, google, openrouter.
# Set the API key of every provider you use. With no key at all the app runs on a fake LLM
# (exercises and grading are simulated; a banner says so).
# For any provider other than anthropic the model id must be set explicitly.
# More (per-task providers, comparing providers with eval-grader): README.md "Choosing the LLM".

# --- Option A: Anthropic (default; model defaults to claude-opus-5-5) ------------------------
ANTHROPIC_API_KEY=

# --- Option B: OpenAI ------------------------------------------------------------------------
# LLMLL_LLM_PROVIDER=openai
# LLMLL_LLM_MODEL=<OpenAI model id>
# OPENAI_API_KEY=
# Only for another OpenAI-compatible server (not needed for OpenAI itself, nor for OpenRouter):
# LLMLL_OPENAI_BASE_URL=https://your-endpoint.example/v1

# --- Option C: Google Gemini -----------------------------------------------------------------
# LLMLL_LLM_PROVIDER=google
# LLMLL_LLM_MODEL=<Gemini model id>
# GEMINI_API_KEY=                     # GOOGLE_API_KEY also works

# --- Option D: OpenRouter --------------------------------------------------------------------
# 1. Create a key at https://openrouter.ai/keys and put it in OPENROUTER_API_KEY.
# 2. Pick a model at https://openrouter.ai/models and copy its id exactly as shown there:
#    it has the form <vendor>/<model>.
# 3. No base URL is needed: with LLMLL_LLM_PROVIDER=openrouter the app connects to
#    https://openrouter.ai/api/v1 by itself. Do NOT set LLMLL_OPENAI_BASE_URL for this.
# LLMLL_LLM_PROVIDER=openrouter
# LLMLL_LLM_MODEL=<vendor>/<model>
# OPENROUTER_API_KEY=
# Optional: identifies the app on OpenRouter's dashboard (sent as X-Title / HTTP-Referer).
# LLMLL_OPENROUTER_APP_NAME=LLMLL
# LLMLL_OPENROUTER_SITE_URL=https://your-domain.example
# If the chosen model doesn't support structured (JSON-schema) output, switch the affected
# tasks to plain JSON mode (validated, with one retry), e.g. for all five tasks:
# LLMLL_LLM_TASKS='{"generate_exercise": {"structured_output": "json"}, "grade_sentence": {"structured_output": "json"}, "explain": {"structured_output": "json"}, "simplify_text": {"structured_output": "json"}, "gloss": {"structured_output": "json"}}'

# --- Mixing providers per task (optional) ----------------------------------------------------
# Tasks: generate_exercise, grade_sentence, explain, simplify_text, gloss.
# Each task can override provider, model, params (passed through to the provider) and
# structured_output. Keys of every provider used must be set.
# LLMLL_LLM_TASKS='{"grade_sentence": {"provider": "anthropic", "effort": "high"}, "gloss": {"provider": "openrouter", "model": "<vendor>/<model>"}}'

# ---------------------------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------------------------
# Shared access token. Leave empty for local use (the API is then open to anyone who can reach it).
# On a server, set a long random value, e.g. `openssl rand -hex 32`.
LLMLL_ACCESS_TOKEN=
# Set to true when the app is served over HTTPS (behind a reverse proxy) so the session cookie is Secure.
# LLMLL_COOKIE_SECURE=true

# Copy to .env and fill in. Never commit .env.
# LLM provider: anthropic (default), openai, google, openrouter. Set the key of the provider(s)
# you use. With no key at all the app runs on a fake LLM (a banner is shown).
ANTHROPIC_API_KEY=
# For any provider other than anthropic the model must be named explicitly, e.g.:
# LLMLL_LLM_PROVIDER=openai
# LLMLL_LLM_MODEL=<model id>
# OPENAI_API_KEY=
# GEMINI_API_KEY=            # or GOOGLE_API_KEY
# OPENROUTER_API_KEY=
# LLMLL_OPENAI_BASE_URL=     # optional OpenAI-compatible endpoint
# LLMLL_OPENROUTER_APP_NAME= # optional, sent to OpenRouter as X-Title
# LLMLL_OPENROUTER_SITE_URL= # optional, sent to OpenRouter as HTTP-Referer
# Per-task provider/model/params (JSON), see README.md "Choosing the LLM":
# LLMLL_LLM_TASKS={"grade_sentence": {"provider": "anthropic", "effort": "high"}}

# Shared access token. Leave empty for local use (the API is then open to anyone who can reach it).
# On a server, set a long random value, e.g. `openssl rand -hex 32`.
LLMLL_ACCESS_TOKEN=
# Set to true when the app is served over HTTPS (behind a reverse proxy) so the session cookie is Secure.
# LLMLL_COOKIE_SECURE=true
